# ===========================
# Core Stack Backend
# ===========================

# Server
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL=postgresql://corestack:corestack@localhost:5432/corestack

# JWT
JWT_SECRET=change-me-to-a-secure-random-string
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# CORS
CORS_ORIGIN=http://localhost:3000

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# Account Lockout
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_DURATION=15m

# Mail
# Driver: "console" (logs to stdout, dev) or "smtp" (sends real emails, prod)
MAIL_DRIVER=console
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=noreply@corestack.dev

# Storage
# Driver: "local" (filesystem, dev) or "s3" (AWS S3 / MinIO / R2, prod)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=

# Cache
# Driver: "memory" (dev) or "redis" (prod)
CACHE_DRIVER=memory
REDIS_URL=redis://localhost:6379

# Queue / Background Jobs
# Driver: "memory" (dev) or "bullmq" (prod, requires Redis)
QUEUE_DRIVER=memory

# Firebase Auth (Social Login)
# Required only if using social login (Google, GitHub, Apple)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# App
APP_NAME=Core Stack
APP_URL=http://localhost:3000

# Logging
LOG_LEVEL=info
