#!/bin/sh

# Roda pre-commit do frontend e backend em paralelo
npm run pre-commit &
pid_front=$!

(cd backend && npm run pre-commit) &
pid_back=$!

# Aguarda ambos e captura exit codes
wait $pid_front
exit_front=$?

wait $pid_back
exit_back=$?

# Falha se qualquer um falhar
if [ $exit_front -ne 0 ] || [ $exit_back -ne 0 ]; then
  echo ""
  [ $exit_front -ne 0 ] && echo "❌ Frontend pre-commit failed"
  [ $exit_back -ne 0 ]  && echo "❌ Backend pre-commit failed"
  exit 1
fi

echo ""
echo "✅ Pre-commit passed (frontend + backend)"
