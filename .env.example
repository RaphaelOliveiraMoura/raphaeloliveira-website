# ==================================
# Core Stack - Variaveis de Ambiente
# ==================================
# Copie este arquivo para .env.local e preencha os valores.
# NUNCA commite .env.local no repositorio.

# ----------------------------------
# Server-only (nunca expor ao client)
# ----------------------------------
DATABASE_URL=
JWT_SECRET=
API_INTERNAL_URL=http://localhost:3001

# ----------------------------------
# Client (prefixo NEXT_PUBLIC_)
# ----------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# ----------------------------------
# Firebase (Social Login)
# ----------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# ----------------------------------
# Build flags
# ----------------------------------
# SKIP_ENV_VALIDATION=true  # Descomente para pular validacao de env (CI, Docker build)
