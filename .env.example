# ==================================
# Core Stack - Variaveis de Ambiente
# ==================================
# Copie este arquivo para .env.local e preencha os valores.
# NUNCA commite .env.local no repositorio.

# ----------------------------------
# Server-only (nunca expor ao client)
# ----------------------------------
DATABASE_URL=
JWT_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=

# ----------------------------------
# Client (prefixo NEXT_PUBLIC_)
# ----------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# ----------------------------------
# Build flags
# ----------------------------------
# SKIP_ENV_VALIDATION=true  # Descomente para pular validacao de env (CI, Docker build)
